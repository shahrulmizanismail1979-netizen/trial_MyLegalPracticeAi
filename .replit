modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "api-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mylitai: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mylitai-irac: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-tests"

[[workflows.workflow]]
name = "api-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-tests"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run test:e2e:corp-drafts && pnpm --filter @workspace/api-server run test:e2e:fab && pnpm --filter @workspace/mylawacad run test:e2e:mobile && pnpm --filter @workspace/api-server run test:e2e:case-home"

[[workflows.workflow]]
name = "artifacts/mylitai: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=25300 BASE_PATH=/mylitai/ pnpm --filter @workspace/mylitai run dev"

[[workflows.workflow]]
name = "artifacts/mylitai-irac: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=25400 BASE_PATH=/mylitai-irac/ pnpm --filter @workspace/mylitai-irac run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0", "google-mail:1.0.0", "elevenlabs:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 18083
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
ADMIN_ALLOWED_EMAILS = "shahrulmizanismail1979@gmail.com,mahmudhamdi80@gmail.com,shahrulmizan@ukm.edu.my,aimanhaziqedu@gmail.com"

[objectStorage]
defaultBucketID = "replit-objstore-a69d1a31-5518-4034-aeae-d74008bd9097"
